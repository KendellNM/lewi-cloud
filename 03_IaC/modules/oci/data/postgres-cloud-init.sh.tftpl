#!/bin/bash
# Prepara PostgreSQL ${pg_major} en Oracle Linux 9. La suscripcion logica y los roles se crean despues
# con scripts/oci-subscriber.sql (requiere el endpoint de RDS y la VPN operativa).
set -euo pipefail
DEV=/dev/oracleoci/oraclevdb
for i in $(seq 1 60); do [ -b "$DEV" ] && break; sleep 5; done
[ -b "$DEV" ] || { echo "volumen de datos no disponible" >&2; exit 1; }

blkid "$DEV" >/dev/null 2>&1 || mkfs.xfs "$DEV"
mkdir -p /var/lib/pgsql
grep -q "$DEV" /etc/fstab || echo "$DEV /var/lib/pgsql xfs defaults,_netdev,nofail 0 2" >> /etc/fstab
mount -a

dnf module enable -y postgresql:${pg_major}
dnf install -y postgresql-server postgresql-contrib
chown -R postgres:postgres /var/lib/pgsql
[ -d /var/lib/pgsql/data/base ] || postgresql-setup --initdb

# Solo escucha en la red privada; TLS y pg_hba se endurecen en el script SQL/ansible posterior.
sed -i "s/^#\?listen_addresses.*/listen_addresses = '*'/" /var/lib/pgsql/data/postgresql.conf
sed -i "s/^#\?max_logical_replication_workers.*/max_logical_replication_workers = 4/" /var/lib/pgsql/data/postgresql.conf
systemctl enable --now postgresql
(firewall-cmd --permanent --add-port=5432/tcp && firewall-cmd --reload) || true
