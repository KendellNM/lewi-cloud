        <mxCell id="n371" value="Restaurar la última copia válida desde Blob Storage (las VM leen con identidad administrada, sin claves) → comprobar datos, secuencias y objetos → instalar certificado Origin CA → cambiar el origen en Cloudflare. Se crea solo durante el ensayo T15." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#232F3E;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1">
